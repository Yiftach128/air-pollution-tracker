<configuration>
    <property name="APP_NAME" value="${app.name:-app}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- One JSON object per line, tailed by Grafana Alloy into Loki. The file is
         named after the service (each Application sets app.name before logback
         starts) so Alloy can label every line with the service it came from.
         UNIX line endings keep the files identical on Windows and Linux; the
         timestamp field is renamed so it is a plain LogQL/JMESPath identifier. -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/${APP_NAME}.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/${APP_NAME}.%d{yyyy-MM-dd}.json</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <lineSeparator>UNIX</lineSeparator>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
            </fieldNames>
        </encoder>
    </appender>

    <!-- The Kafka clients narrate their whole configuration and every broker
         hiccup at INFO; only their warnings are worth keeping. -->
    <logger name="org.apache.kafka" level="WARN"/>

    <!-- Hibernate logs every SQLException at WARN+ERROR before rethrowing it. The exceptions the
         project expects (a reading already stored, a database that is down) are handled and logged
         by the code that catches them, so the duplicate lines are noise. -->
    <logger name="org.hibernate.engine.jdbc.spi.SqlExceptionHelper" level="OFF"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
