# Copy this file to `.env` (git-ignored) and fill in the values.
# Every service reads these through com.pollution.common.config.Env whenever the variable
# is not set in the process environment (the process environment always wins). The nearest
# .env upward from the working directory is used, so the repository root's is found from any module.
# Format: NAME=value, one per line; blank lines and # lines are ignored; an empty value is unset.

# ---- persistence-postgres: the relational store (pollution-data-writer, -api-service) ------
# The writer keeps every reading in PostgreSQL and the API service reads them back; both fail
# at startup if they cannot connect.
# Defaults shown; the database and user must exist (the table is created on first start).
#POSTGRES_HOST=localhost
#POSTGRES_PORT=5432
#POSTGRES_DB=pollution
#POSTGRES_USER=pollution
# Password of POSTGRES_USER; leave empty for a database that needs none.
POSTGRES_PASSWORD=
# Most connections a service keeps open to the database.
#POSTGRES_POOL_SIZE=4

# ---- persistence-redis: the cache (pollution-data-writer, -analyzer, -alert-service, -api-service)
# Defaults shown.
#REDIS_HOST=localhost
#REDIS_PORT=6379

# ---- persistence-common: current readings (written by the writer, shown by the API service)
# The writer also keeps the newest reading of every sensor and pollutant in Redis, for fast
# "right now" lookups. Minutes a reading stays current when no newer one replaces it; after
# that the sensor has no current reading until it reports again.
#LATEST_READING_TTL_MINUTES=60

# ---- pollution-data-collector: the sensors -----------------------------------------------
# The PurpleAir sensors this instance polls, comma-separated, each as <sensor_index>=<city>
# (sensor_index is the select= value in a map.purpleair.com URL; the city is ours - PurpleAir
# has none). Default: the two sensors compiled into the collector's Config, shown here. A
# malformed entry is a startup error; the instance logs the sensors it follows when it starts.
# Several collectors split the sensors by each getting its own list. The lists must not
# overlap - nothing checks that across processes, and an overlapping sensor is polled, stored
# and averaged twice. To run a second collector on this machine, set the variable in that
# process's environment (it wins over this file) and give the process its own -Dapp.name so
# its JSON log file does not collide with the first one's.
#PURPLEAIR_SENSORS=308702=Ganei Ayalon,298123=Shoham
# PurpleAir read keys, comma-separated, used round-robin; the default is compiled in.
#PURPLEAIR_API_KEYS=

# ---- pollution-api-service: the dashboard ------------------------------------------------
# The page is served at http://<API_BIND_ADDRESS>:<API_PORT>/ and its JSON API under /api/.
# Defaults shown. The default bind address keeps the dashboard reachable from this machine
# only; set 0.0.0.0 to serve it to the network.
#API_PORT=8080
#API_BIND_ADDRESS=127.0.0.1
# How far back a history request reaches when it does not say, in hours.
#API_DEFAULT_HISTORY_HOURS=24
# The longest range one history request may ask for, in days.
#API_MAX_HISTORY_DAYS=365

# ---- pollution-alert-service: Telegram delivery ------------------------------------------
# Set both to post alerts to Telegram; leave both empty to only log alerts.
# Setting just one is a startup error.

# The bot token from @BotFather (/newbot), e.g. 1234567890:AAF0xkq...
TELEGRAM_BOT_TOKEN=

# The alerts channel: its numeric id (-100... including the minus sign), or @username for a
# public channel. The bot must be an admin of the channel with "Post messages".
TELEGRAM_CHAT_ID=

# ---- thresholds (shared by pollution-alert-service and pollution-api-service) --------------
# The concentrations a measurement must exceed to count - a baseline per pollutant and a factor
# per measurement length - are in pollution-common/src/main/resources/thresholds.json, packaged
# with every service. To read another file instead, without a rebuild:
#THRESHOLDS_FILE=

# ---- pollution-alert-service: cooldowns (all optional; defaults shown) --------------------
# Minutes a series (sensor + pollutant + measurement type) stays quiet after an alert, per type.
# Defaults: each window's own length, single readings 10. ALERT_COOLDOWN_MINUTES alone sets all
# four at once (handy for testing); the per-type variables win over it.
#ALERT_COOLDOWN_MINUTES=
#ALERT_COOLDOWN_MINUTES_PT10M=10
#ALERT_COOLDOWN_MINUTES_PT1H=60
#ALERT_COOLDOWN_MINUTES_PT24H=1440
#ALERT_COOLDOWN_MINUTES_RAW=10
# Not configurable: while a longer window of the same sensor + pollutant is cooling down, shorter
# measurements (down to single readings) are not alerted — they are old news.

# ---- all services: running in containers -------------------------------------------------
# Both unset by default, which is right for processes on a developer's machine. A container
# platform's manifest sets them in the process environment.
# json: one JSON object per log line on stdout and no logs/<service>.json file (the platform
# collects stdout, and replicas must not share a file). text (the default): readable console
# lines plus the JSON file. Read by logback itself, before Env runs, so this file cannot set
# it - only the process environment can.
#LOG_FORMAT=text
# Port of the health server answering the platform's probes: GET /healthz (liveness: 200 while
# the process runs) and GET /readyz (readiness: 200 once the service has started, else 503).
# Unset or 0: no health server. It listens on every interface.
#HEALTH_PORT=
